#!/usr/bin/env node
const fs = require("fs");
const args = process.argv.slice(2);
const log = process.env.FAKE_LOG;
if (log) fs.appendFileSync(log, JSON.stringify({ bin: "agy", args, cwd: process.cwd() }) + "\n");
if (args[0] === "--version") {
  process.stdout.write("1.0.0\n");
  process.exit(0);
}
if (args[0] === "models") {
  process.stdout.write("Fetching available models...\nflash-x-high\tFlash X (High)\nflash-x-low\tFlash X (Low)\npro-y-medium\tPro Y (Medium)\nsolo-z\tSolo Z\n");
  process.exit(0);
}
if (process.env.FAKE_MODE === "no-auto" && args[args.indexOf("--mode") + 1] === "auto") {
  process.stderr.write("warning: --mode auto is not available for this account; continuing in the default mode.\n");
  setTimeout(() => {}, 60000);
  return;
}
const mode = process.env.FAKE_MODE || "ok";
if (args.includes("--log-file") && mode !== "no-label") {
  const chosen = args.includes("--model") ? args[args.indexOf("--model") + 1] : "Account Default";
  const level = args.includes("--effort") ? args[args.indexOf("--effort") + 1] : "Label";
  fs.writeFileSync(args[args.indexOf("--log-file") + 1], `I1 model_config_manager.go:340] Propagating selected model override to backend: label="${chosen} (${level})"\n`);
}
const delay = Number(process.env.FAKE_DELAY_MS || 0);
const conv = args.includes("--conversation") ? args[args.indexOf("--conversation") + 1] : "conv-" + Date.now();
const prompt = args[args.indexOf("-p") + 1] || "";
if (args.includes("stream-json") && Number(process.env.FAKE_DELAY_MS || 0) > 0) {
  process.stdout.write(JSON.stringify({ event: "step_update", step_update: { step_index: 1, state: "DONE", step_type: "tool", tool_name: "view_file", tool_info: { parameters: { AbsolutePath: process.cwd() + "/a.py" } } } }) + "\n");
}
setTimeout(() => {
  if (mode === "error") {
    process.stderr.write("error: invalid model selection\n");
    process.stdout.write(JSON.stringify({ conversation_id: "", status: "ERROR", error: "invalid model selection: nope" }));
    process.exit(1);
  }
  if (mode === "timeout") process.stderr.write("[agy] print timeout after 5s with turn in progress; returning partial output\n");
  const out = { conversation_id: conv, status: "SUCCESS", response: process.env.FAKE_RESPONSE || `answer to: ${prompt.split("\n\n").pop().slice(0, 40)}`, duration_seconds: 1, num_turns: 1 };
  if (mode === "denied") out.denied_actions = [{ action: "command", display_name: "RunCommand" }];
  if ((mode === "denied-once" && !args.includes("--conversation")) || mode === "denied-always" || mode === "denied-empty-structured") {
    out.response = "";
    out.denied_actions = [{ action: "command", display_name: "RunCommand" }];
  }
  if (args.includes("--json-schema")) {
    out.structured_output = { verdict: "needs-attention", summary: "Do not ship.", findings: [
      { severity: "low", title: "Minor", body: "small", file: "a.py", line_start: 1, line_end: 1, confidence: 0.3, recommendation: "fix" },
      { severity: "critical", title: "Divides by zero", body: "len-1 is 0 for one item", file: "a.py", line_start: 2, line_end: 2, confidence: 0.9, recommendation: "use len(xs)" }
    ], next_steps: ["Fix the divisor"] };
  }
  if (mode === "denied-empty-structured") out.structured_output = out.structured_output || { verdict: "approve", summary: "ok", findings: [], next_steps: [] };
  if (mode === "retry-crash" && args.includes("--conversation")) {
    process.stdout.write(JSON.stringify({ conversation_id: "", status: "ERROR", error: "boom" }));
    process.exit(1);
  }
  if (mode === "retry-crash") {
    out.response = "";
    out.denied_actions = [{ action: "command", display_name: "RunCommand" }];
  }
  if (args.includes("stream-json") && mode !== "error") {
    const lines = [
      { event: "init", conversation_id: conv, init: { model: args.includes("--model") ? args[args.indexOf("--model") + 1] : "account-default-model" } },
      { event: "step_update", step_update: { step_index: 1, state: "ACTIVE", step_type: "tool", tool_name: "read_file", tool_info: { parameters: { Path: process.cwd() + "/a.py" } } } },
      { event: "step_update", step_update: { step_index: 1, state: "DONE", step_type: "tool", tool_name: "read_file", tool_info: { parameters: { Path: process.cwd() + "/a.py" } } } },
      { event: "step_update", step_update: { step_index: 2, state: "ACTIVE", step_type: "agent_response" } },
      { event: "step_update", step_update: { step_index: 2, state: "ACTIVE", step_type: "agent_response" } },
      { event: "result", result: out }
    ];
    process.stdout.write(lines.map((l) => JSON.stringify(l)).join("\n") + "\n");
  } else {
    process.stdout.write(JSON.stringify(out));
  }
}, delay);
